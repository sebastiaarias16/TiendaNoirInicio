# ==============================================================================
# NOIR APPAREL — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS OR SENSITIVE KEYS TO GIT.
# ==============================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (For CORS, Webhook Redirects & Email Verification)
FRONTEND_URL=http://localhost:3000

# Transactional Email (Nodemailer / Gmail App Password or SMTP)
EMAIL_USER=contacto@tiendanoir.com
EMAIL_PASS=your_smtp_app_password

# ==============================================================================
# WOMPI PAYMENT GATEWAY CONFIGURATION (COLOMBIA)
# Docs: https://docs.wompi.co
# ==============================================================================
# Environment: 'sandbox' for testing, 'production' for live payments
WOMPI_ENVIRONMENT=sandbox

# Public Key (Safe to expose to frontend checkout widget)
# Sandbox starts with pub_stagtest_, Production starts with pub_prod_
WOMPI_PUBLIC_KEY=pub_stagtest_your_wompi_public_key

# Private Key (STRICTLY BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
# Sandbox starts with prv_stagtest_, Production starts with prv_prod_
WOMPI_PRIVATE_KEY=prv_stagtest_your_wompi_private_key

# Integrity Secret (STRICTLY BACKEND ONLY - Used to sign transaction references)
# Sandbox starts with stagtest_integrity_, Production starts with prod_integrity_
WOMPI_INTEGRITY_SECRET=stagtest_integrity_your_integrity_secret

# Events Secret (STRICTLY BACKEND ONLY - Used to verify webhook checksums)
# Sandbox starts with stagtest_events_, Production starts with prod_events_
WOMPI_EVENTS_SECRET=stagtest_events_your_events_secret

# Optional API Overrides (Defaults to sandbox or production based on WOMPI_ENVIRONMENT)
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_BASE_URL=https://checkout.wompi.co

# ==============================================================================
# WHATSAPP DISPATCH & NOTIFICATIONS
# ==============================================================================
WHATSAPP_PHONE=573124252861
